class DemoDeviceRegistry:
    """Bounded least-recently-used collection of private demo computers."""

    def __init__(self, factory, maximum=MAX_DEMO_SESSIONS):
        self.factory = factory
        self.maximum = maximum
        self.lock = threading.RLock()
        self.devices = collections.OrderedDict()

    def get(self, session_id):
        with self.lock:
            device = self.devices.pop(session_id, None)
            if device is None:
                if len(self.devices) >= self.maximum:
                    self.devices.popitem(last=False)
                device = self.factory()
            self.devices[session_id] = device
            return device

    def __len__(self):
        with self.lock:
            return len(self.devices)


class DemoDevice:
    """A few kilobytes of state rendered as a tiny computer-like SVG."""

    def __init__(self, hid, character_map, base_video_settings):
        self.lock = threading.RLock()
        self.hid = hid
        self.character_map = character_map
        self.base_video_settings = base_video_settings
        self.owner = None
        self.reset()

    def ensure_owner(self, username):
        with self.lock:
            if username and self.owner is None:
                self.owner = username
                self.users = {username: 'ADMIN'}

    def reset(self):
        with self.lock:
            self.hostname = 'tinydesk'
            self.wifi = (None, None)
            self.updated_at = None
            self.version = '0.0.0-webmcp-demo'
            self.service_events = []
            self.requires_https = False
            self.streaming_mode = 'MJPEG'
            self.video_settings = copy.deepcopy(self.base_video_settings)
            self.users = {self.owner: 'ADMIN'} if self.owner else {}
            self.text = ''
            self.cursor = 0
            self.selected_all = False
            self.caps_lock = False
            self.pointer = (0.56, 0.45)
            self.buttons = 0
            self.scroll = 0
            self.key_count = 0
            self.mouse_count = 0
            self.active_tab = 'notes'
            self.calculator_display = '0'
            self.calculator_accumulator = None
            self.calculator_operator = None
            self.calculator_new_entry = True
            self.snake = [(8, 6), (7, 6), (6, 6)]
            self.snake_food = (13, 6)
            self.snake_direction = (1, 0)
            self.snake_score = 0
            self.snake_game_over = False
            self.last_input = 'Ready for keyboard and mouse input'
            self.saved = False
            self.revision = 0

    def service_event(self, message):
        with self.lock:
            self.service_events.append(message)
            self.service_events = self.service_events[-12:]
            self.revision += 1

    def _insert(self, value):
        if self.selected_all:
            self.text, self.cursor = '', 0
            self.selected_all = False
        available = MAX_TEXT - len(self.text)
        value = value[:max(available, 0)]
        self.text = self.text[:self.cursor] + value + self.text[self.cursor:]
        self.cursor += len(value)
        self.saved = False

    @staticmethod
    def _format_calculator(value):
        if abs(value) > 999999999 or (value and abs(value) < 0.000001):
            return f'{value:.6g}'
        if value == int(value):
            return str(int(value))
        return f'{value:.8f}'.rstrip('0').rstrip('.')

    def _calculate(self):
        if self.calculator_operator is None or self.calculator_accumulator is None:
            return
        try:
            right = float(self.calculator_display)
            left = self.calculator_accumulator
            if self.calculator_operator == '+':
                result = left + right
            elif self.calculator_operator == '-':
                result = left - right
            elif self.calculator_operator == '*':
                result = left * right
            else:
                result = left / right
            self.calculator_display = self._format_calculator(result)
            self.last_input = 'Calculator result ready'
        except (ValueError, ZeroDivisionError, OverflowError):
            self.calculator_display = 'Error'
            self.last_input = 'Calculator cannot complete that operation'
        self.calculator_accumulator = None
        self.calculator_operator = None
        self.calculator_new_entry = True

    def _calculator_character(self, character):
        if character.isdigit():
            if self.calculator_new_entry or self.calculator_display == 'Error':
                self.calculator_display = character
            elif len(self.calculator_display) < 12:
                self.calculator_display += character
            self.calculator_new_entry = False
            self.last_input = f'Calculator entered {character}'
        elif character == '.':
            if self.calculator_new_entry or self.calculator_display == 'Error':
                self.calculator_display = '0.'
            elif '.' not in self.calculator_display:
                self.calculator_display += '.'
            self.calculator_new_entry = False
        elif character in '+-*/':
            if self.calculator_operator is not None and not self.calculator_new_entry:
                self._calculate()
            try:
                self.calculator_accumulator = float(self.calculator_display)
            except ValueError:
                self.calculator_accumulator = 0.0
            self.calculator_operator = character
            self.calculator_new_entry = True
            self.last_input = f'Calculator operator {character}'

    def _calculator_action(self, action):
        if action == 'clear':
            self.calculator_display = '0'
            self.calculator_accumulator = None
            self.calculator_operator = None
            self.calculator_new_entry = True
            self.last_input = 'Calculator cleared'
        elif action == 'backspace':
            if not self.calculator_new_entry:
                self.calculator_display = self.calculator_display[:-1] or '0'
            self.last_input = 'Calculator deleted one digit'
        elif action == 'equals':
            self._calculate()
        else:
            self._calculator_character(action)

    def _calculator_click(self, pixel_x, pixel_y):
        actions = [
            'clear', '/', '*', '-', '7', '8', '9', '+', '4', '5', '6',
            'equals', '1', '2', '3', '0', '.', 'backspace'
        ]
        if 273 <= pixel_y < 526:
            row = int((pixel_y - 273) / 67)
            column = int((pixel_x - 370) / 140)
            index = row * 4 + column
            if (0 <= column < 4 and index < 16 and
                    pixel_x - (370 + column * 140) <= 120 and
                    pixel_y - (273 + row * 67) <= 52):
                self._calculator_action(actions[index])
        elif 541 <= pixel_y <= 593:
            column = int((pixel_x - 370) / 186)
            index = 16 + column
            if (0 <= column < 3 and
                    pixel_x - (370 + column * 186) <= 166):
                self._calculator_action(actions[index])

    def _reset_snake(self):
        self.snake = [(8, 6), (7, 6), (6, 6)]
        self.snake_food = (13, 6)
        self.snake_direction = (1, 0)
        self.snake_score = 0
        self.snake_game_over = False
        self.last_input = 'Snake ready — use arrow keys'

    def _move_snake(self, direction=None):
        if self.snake_game_over:
            self._reset_snake()
            return
        if direction:
            opposite = (-self.snake_direction[0], -self.snake_direction[1])
            if direction != opposite:
                self.snake_direction = direction
        head_x, head_y = self.snake[0]
        next_head = (head_x + self.snake_direction[0],
                     head_y + self.snake_direction[1])
        if (next_head[0] < 0 or next_head[0] >= 18 or next_head[1] < 0 or
                next_head[1] >= 12 or next_head in self.snake[:-1]):
            self.snake_game_over = True
            self.last_input = 'Snake game over — press an arrow to restart'
            return
        self.snake.insert(0, next_head)
        if next_head == self.snake_food:
            self.snake_score += 1
            candidate = ((3 + self.snake_score * 5) % 18,
                         (2 + self.snake_score * 7) % 12)
            while candidate in self.snake:
                candidate = ((candidate[0] + 3) % 18,
                             (candidate[1] + 1) % 12)
            self.snake_food = candidate
            self.last_input = f'Snake score {self.snake_score}'
        else:
            self.snake.pop()
            self.last_input = 'Snake moved one tile'

    def send_key(self, _path, key):
        with self.lock:
            code, modifier = key.keycode, key.modifier
            if code == 0:
                return
            self.key_count += 1
            self.revision += 1
            self.last_input = f'Keyboard input {self.key_count} received'
            hid = self.hid
            ctrl = modifier & (hid.MODIFIER_LEFT_CTRL | hid.MODIFIER_RIGHT_CTRL)
            meta = modifier & (hid.MODIFIER_LEFT_META | hid.MODIFIER_RIGHT_META)
            alt = modifier & (hid.MODIFIER_LEFT_ALT | hid.MODIFIER_RIGHT_ALT)
            shift = modifier & (hid.MODIFIER_LEFT_SHIFT |
                                hid.MODIFIER_RIGHT_SHIFT)
            if (ctrl or meta) and not alt:
                if self.active_tab == 'notes' and code == hid.KEYCODE_A:
                    self.selected_all = True
                    self.last_input = 'Selected all note text'
                elif self.active_tab == 'notes' and code == hid.KEYCODE_S:
                    self.saved = True
                    self.last_input = 'Note saved in demo memory'
                else:
                    self.last_input = 'Modifier chord received by demo target'
                return
            if ctrl or meta or alt:
                self.last_input = 'System shortcut received (simulated only)'
                return
            if self.active_tab == 'snake':
                directions = {
                    hid.KEYCODE_UP_ARROW: (0, -1),
                    hid.KEYCODE_RIGHT_ARROW: (1, 0),
                    hid.KEYCODE_DOWN_ARROW: (0, 1),
                    hid.KEYCODE_LEFT_ARROW: (-1, 0),
                }
                if code in directions:
                    self._move_snake(directions[code])
                elif code == hid.KEYCODE_SPACEBAR:
                    self._move_snake()
                elif code == hid.KEYCODE_ESCAPE:
                    self._reset_snake()
                else:
                    self.last_input = 'Snake uses arrow keys or Space'
                return
            if self.active_tab == 'calculator':
                if code == hid.KEYCODE_ESCAPE:
                    self._calculator_action('clear')
                elif code == hid.KEYCODE_BACKSPACE_DELETE:
                    self._calculator_action('backspace')
                elif code in (hid.KEYCODE_ENTER, hid.KEYCODE_NUMPAD_ENTER) or (
                        code == hid.KEYCODE_EQUAL_SIGN and not shift):
                    self._calculator_action('equals')
                else:
                    canonical_modifier = hid.MODIFIER_LEFT_SHIFT if shift else 0
                    character = self.character_map.get((code, canonical_modifier))
                    if character is not None:
                        self._calculator_character(character)
                    else:
                        self.last_input = 'Calculator accepts numbers and operators'
                return
            if code == hid.KEYCODE_CAPS_LOCK:
                self.caps_lock = not self.caps_lock
            elif code == hid.KEYCODE_ESCAPE:
                self.selected_all = False
            elif code == hid.KEYCODE_BACKSPACE_DELETE:
                if self.selected_all:
                    self.text, self.cursor, self.selected_all = '', 0, False
                elif self.cursor:
                    self.text = self.text[:self.cursor -
                                          1] + self.text[self.cursor:]
                    self.cursor -= 1
                self.saved = False
            elif code == hid.KEYCODE_DELETE:
                if self.selected_all:
                    self.text, self.cursor, self.selected_all = '', 0, False
                else:
                    self.text = self.text[:self.
                                          cursor] + self.text[self.cursor + 1:]
                self.saved = False
            elif code == hid.KEYCODE_LEFT_ARROW:
                self.cursor = max(0, self.cursor - 1)
                self.selected_all = False
            elif code == hid.KEYCODE_RIGHT_ARROW:
                self.cursor = min(len(self.text), self.cursor + 1)
                self.selected_all = False
            elif code == hid.KEYCODE_HOME:
                self.cursor = self.text.rfind('\n', 0, self.cursor) + 1
            elif code == hid.KEYCODE_END:
                end = self.text.find('\n', self.cursor)
                self.cursor = len(self.text) if end == -1 else end
            elif code in (hid.KEYCODE_ENTER, hid.KEYCODE_NUMPAD_ENTER):
                self._insert('\n')
            else:
                canonical_modifier = hid.MODIFIER_LEFT_SHIFT if shift else 0
                character = self.character_map.get((code, canonical_modifier))
                if character is not None:
                    if self.caps_lock and character.isalpha():
                        character = character.swapcase()
                    self._insert(character)
                else:
                    self.last_input = f'USB key {code:#04x} received (simulated only)'

    def send_keys(self, path, keys):
        for key in keys:
            self.send_key(path, key)

    def release_keys(self, _path):
        # No USB keys are ever held by this simulated target.
        return None

    def mouse(self, _path, buttons, relative_x, relative_y, vertical,
              horizontal):
        with self.lock:
            self.pointer = (relative_x, relative_y)
            self.mouse_count += 1
            self.revision += 1
            if buttons and not self.buttons:
                self.last_input = 'Mouse click received by demo target'
                pixel_x = relative_x * WIDTH
                pixel_y = relative_y * HEIGHT
                if relative_x < 0.135:
                    if 0.08 < relative_y < 0.24:
                        self.active_tab = 'notes'
                    elif 0.25 < relative_y < 0.41:
                        self.active_tab = 'calculator'
                    elif 0.42 < relative_y < 0.58:
                        self.active_tab = 'snake'
                    elif 0.59 < relative_y < 0.75:
                        self.active_tab = 'input'
                elif relative_y > 0.90:
                    dock_index = int((relative_x - 0.39) / 0.065)
                    apps = ('notes', 'calculator', 'snake', 'input')
                    if 0 <= dock_index < len(apps):
                        self.active_tab = apps[dock_index]
                elif self.active_tab == 'calculator':
                    self._calculator_click(pixel_x, pixel_y)
                elif (self.active_tab == 'snake' and self.snake_game_over and
                      339 <= pixel_x <= 941 and 184 <= pixel_y <= 586):
                    self._reset_snake()
            elif vertical or horizontal:
                self.scroll = max(0, self.scroll + vertical)
                self.last_input = 'Scroll received by demo target'
            self.buttons = buttons

    def state(self):
        with self.lock:
            return {
                'demo': True,
                'physicalHardware': False,
                'sessionIsolated': True,
                'runtime': 'in-memory-svg',
                'text': self.text,
                'cursor': self.cursor,
                'keysReceived': self.key_count,
                'mouseEventsReceived': self.mouse_count,
                'pointer': self.pointer,
                'lastInput': self.last_input,
                'saved': self.saved,
                'activeApp': self.active_tab,
                'calculatorDisplay': self.calculator_display,
                'snakeScore': self.snake_score,
                'snakeGameOver': self.snake_game_over,
                'revision': self.revision,
                'serviceEvents': list(self.service_events),
            }

