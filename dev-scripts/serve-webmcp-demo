#!/usr/bin/env python3
"""Run TinyPilot with a disposable, visibly simulated device.

Usage: venv/bin/python3 dev-scripts/serve-webmcp-demo --port 8000

Uses the real Flask routes, authentication, CSRF, request parsers, SQLite
migrations, and Socket.IO input handlers. Each browser receives a private,
bounded in-memory micro desktop rendered as SVG—no VM, browser engine, subprocess,
or operating system is created per user. Typed text never executes. Power,
updates, accounts, Wi-Fi, hostname, diagnostics, and video preferences use
session-private sample state. At most 128 least-recently-used sessions are kept,
and all state is discarded on exit. This is not proof of physical hardware.

For an external bind, provide --username and set TINYPILOT_DEMO_PASSWORD (or
--password-env NAME). Use an HTTPS reverse proxy for browser WebMCP support.
The Flask debugger and reloader are always disabled, including external binds.
"""

import argparse
import collections
import copy
import html
import importlib
import logging
import os
import pathlib
import re
import secrets
import string
import sys
import tempfile
import threading
import time
import types

DEMO_LABEL = 'Session-private demo — no physical hardware or VM'
DEMO_SESSION_KEY = 'webmcp_demo_session'
MAX_DEMO_SESSIONS = 128
MAX_TEXT = 8192
WIDTH = 1280
HEIGHT = 720


class DemoDeviceRegistry:
    """Bounded least-recently-used collection of private demo computers."""

    def __init__(self, factory, maximum=MAX_DEMO_SESSIONS):
        self.factory = factory
        self.maximum = maximum
        self.lock = threading.RLock()
        self.devices = collections.OrderedDict()

    def get(self, session_id):
        with self.lock:
            device = self.devices.pop(session_id, None)
            if device is None:
                if len(self.devices) >= self.maximum:
                    self.devices.popitem(last=False)
                device = self.factory()
            self.devices[session_id] = device
            return device

    def __len__(self):
        with self.lock:
            return len(self.devices)


class DemoDevice:
    """A few kilobytes of state rendered as a tiny computer-like SVG."""

    def __init__(self, hid, character_map, base_video_settings):
        self.lock = threading.RLock()
        self.hid = hid
        self.character_map = character_map
        self.base_video_settings = base_video_settings
        self.owner = None
        self.reset()

    def ensure_owner(self, username):
        with self.lock:
            if username and self.owner is None:
                self.owner = username
                self.users = {username: 'ADMIN'}

    def reset(self):
        with self.lock:
            self.hostname = 'tinydesk'
            self.wifi = (None, None)
            self.updated_at = None
            self.version = '0.0.0-webmcp-demo'
            self.service_events = []
            self.requires_https = False
            self.streaming_mode = 'MJPEG'
            self.video_settings = copy.deepcopy(self.base_video_settings)
            self.users = {self.owner: 'ADMIN'} if self.owner else {}
            self.text = ''
            self.cursor = 0
            self.selected_all = False
            self.caps_lock = False
            self.pointer = (0.56, 0.45)
            self.buttons = 0
            self.scroll = 0
            self.key_count = 0
            self.mouse_count = 0
            self.active_tab = 'notes'
            self.last_input = 'Ready for keyboard and mouse input'
            self.saved = False
            self.revision = 0

    def service_event(self, message):
        with self.lock:
            self.service_events.append(message)
            self.service_events = self.service_events[-12:]
            self.revision += 1

    def _insert(self, value):
        if self.selected_all:
            self.text, self.cursor = '', 0
            self.selected_all = False
        available = MAX_TEXT - len(self.text)
        value = value[:max(available, 0)]
        self.text = self.text[:self.cursor] + value + self.text[self.cursor:]
        self.cursor += len(value)
        self.saved = False

    def send_key(self, _path, key):
        with self.lock:
            code, modifier = key.keycode, key.modifier
            if code == 0:
                return
            self.key_count += 1
            self.revision += 1
            self.last_input = f'Keyboard input {self.key_count} received'
            hid = self.hid
            ctrl = modifier & (hid.MODIFIER_LEFT_CTRL | hid.MODIFIER_RIGHT_CTRL)
            meta = modifier & (hid.MODIFIER_LEFT_META | hid.MODIFIER_RIGHT_META)
            alt = modifier & (hid.MODIFIER_LEFT_ALT | hid.MODIFIER_RIGHT_ALT)
            shift = modifier & (hid.MODIFIER_LEFT_SHIFT |
                                hid.MODIFIER_RIGHT_SHIFT)
            if (ctrl or meta) and not alt:
                if code == hid.KEYCODE_A:
                    self.selected_all = True
                    self.last_input = 'Selected all note text'
                elif code == hid.KEYCODE_S:
                    self.saved = True
                    self.last_input = 'Note saved in demo memory'
                else:
                    self.last_input = 'Modifier chord received by demo target'
                return
            if ctrl or meta or alt:
                self.last_input = 'System shortcut received (simulated only)'
                return
            if code == hid.KEYCODE_CAPS_LOCK:
                self.caps_lock = not self.caps_lock
            elif code == hid.KEYCODE_ESCAPE:
                self.selected_all = False
            elif code == hid.KEYCODE_BACKSPACE_DELETE:
                if self.selected_all:
                    self.text, self.cursor, self.selected_all = '', 0, False
                elif self.cursor:
                    self.text = self.text[:self.cursor -
                                          1] + self.text[self.cursor:]
                    self.cursor -= 1
                self.saved = False
            elif code == hid.KEYCODE_DELETE:
                if self.selected_all:
                    self.text, self.cursor, self.selected_all = '', 0, False
                else:
                    self.text = self.text[:self.
                                          cursor] + self.text[self.cursor + 1:]
                self.saved = False
            elif code == hid.KEYCODE_LEFT_ARROW:
                self.cursor = max(0, self.cursor - 1)
                self.selected_all = False
            elif code == hid.KEYCODE_RIGHT_ARROW:
                self.cursor = min(len(self.text), self.cursor + 1)
                self.selected_all = False
            elif code == hid.KEYCODE_HOME:
                self.cursor = self.text.rfind('\n', 0, self.cursor) + 1
            elif code == hid.KEYCODE_END:
                end = self.text.find('\n', self.cursor)
                self.cursor = len(self.text) if end == -1 else end
            elif code in (hid.KEYCODE_ENTER, hid.KEYCODE_NUMPAD_ENTER):
                self._insert('\n')
            else:
                canonical_modifier = hid.MODIFIER_LEFT_SHIFT if shift else 0
                character = self.character_map.get((code, canonical_modifier))
                if character is not None:
                    if self.caps_lock and character.isalpha():
                        character = character.swapcase()
                    self._insert(character)
                else:
                    self.last_input = f'USB key {code:#04x} received (simulated only)'

    def send_keys(self, path, keys):
        for key in keys:
            self.send_key(path, key)

    def release_keys(self, _path):
        # No USB keys are ever held by this simulated target.
        return None

    def mouse(self, _path, buttons, relative_x, relative_y, vertical,
              horizontal):
        with self.lock:
            self.pointer = (relative_x, relative_y)
            self.mouse_count += 1
            self.revision += 1
            if buttons and not self.buttons:
                self.last_input = 'Mouse click received by demo target'
                if relative_x < 0.12 and 0.10 < relative_y < 0.26:
                    self.active_tab = 'notes'
                elif relative_x < 0.12 and 0.28 < relative_y < 0.44:
                    self.active_tab = 'input'
            elif vertical or horizontal:
                self.scroll = max(0, self.scroll + vertical)
                self.last_input = 'Scroll received by demo target'
            self.buttons = buttons

    def state(self):
        with self.lock:
            return {
                'demo': True,
                'physicalHardware': False,
                'sessionIsolated': True,
                'runtime': 'in-memory-svg',
                'text': self.text,
                'cursor': self.cursor,
                'keysReceived': self.key_count,
                'mouseEventsReceived': self.mouse_count,
                'pointer': self.pointer,
                'lastInput': self.last_input,
                'saved': self.saved,
                'revision': self.revision,
                'serviceEvents': list(self.service_events),
            }

    def svg(self):
        """Render only escaped text; no user SVG, links, script, or HTML."""
        with self.lock:
            body = []

            def text(x, y, value, size=20, color='#dbe6f5', weight='400'):
                body.append(
                    f'<text x="{x}" y="{y}" fill="{color}" font-size="{size}" '
                    f'font-weight="{weight}">{html.escape(str(value))}</text>')

            body.extend([
                '<rect width="1280" height="720" fill="#315b78"/>',
                '<rect width="1280" height="42" fill="#17242f"/>',
                '<rect y="680" width="1280" height="40" fill="#17242f"/>',
                '<rect x="170" y="72" width="1068" height="574" rx="9" '
                'fill="#f7f8fa" stroke="#12202b" stroke-width="2"/>',
                '<rect x="170" y="72" width="1068" height="48" rx="9" fill="#e6e9ed"/>',
                '<rect x="170" y="111" width="1068" height="9" fill="#e6e9ed"/>',
                '<circle cx="194" cy="96" r="6" fill="#e06055"/>',
                '<circle cx="214" cy="96" r="6" fill="#e2aa3d"/>',
                '<circle cx="234" cy="96" r="6" fill="#50ad67"/>',
                '<rect x="24" y="78" width="112" height="108" rx="10" fill="#23475f"/>',
                '<rect x="24" y="202" width="112" height="108" rx="10" fill="#23475f"/>',
            ])
            text(18, 28, 'TinyDesk', 18, '#f7fbff', '600')
            text(930, 28, 'IN-MEMORY DEMO · NO VM', 14, '#bfd2df')
            text(57, 124, '▤', 38, '#f7fbff')
            text(47, 163, 'Notes', 17, '#f7fbff', '600')
            text(57, 248, '⌁', 38, '#f7fbff')
            text(39, 287, 'Activity', 17, '#f7fbff', '600')
            window_title = 'Notes' if self.active_tab == 'notes' else 'Input activity'
            text(257, 103, window_title, 18, '#243440', '600')
            text(1075, 103, 'Saved' if self.saved else 'Session only', 14,
                 '#526875')
            if self.active_tab == 'notes':
                text(198, 151,
                     'Type anywhere in this note. Ctrl+S marks it saved.', 15,
                     '#647782')
                body.append('<line x1="198" y1="169" x2="1208" y2="169" '
                            'stroke="#d9dfe3"/>')
                lines = self.text.expandtabs(4).split('\n')
                visual_lines = []
                for line in lines:
                    visual_lines.extend(
                        [line[i:i + 88] for i in range(0, len(line), 88)] or
                        [''])
                offset = min(self.scroll, max(0, len(visual_lines) - 15))
                if self.selected_all and self.text:
                    body.append(
                        '<rect x="194" y="181" width="1016" height="405" '
                        'rx="4" fill="#d5e9f7"/>')
                for index, line in enumerate(visual_lines[offset:offset + 15]):
                    text(199, 208 + index * 25, line, 18, '#17242f')
                if not self.text:
                    text(199, 208, 'Your private demo note appears here…', 18,
                         '#98a5ad')
                text(
                    198, 620, f'{len(self.text)} / {MAX_TEXT} characters  ·  '
                    f'Caret {self.cursor}', 13, '#647782')
            else:
                text(198, 166,
                     'Real TinyPilot input handlers, session-private state', 18,
                     '#243440', '600')
                text(198, 226, f'Keyboard events     {self.key_count}', 20,
                     '#334a58')
                text(198, 270, f'Pointer events      {self.mouse_count}', 20,
                     '#334a58')
                text(
                    198, 314, f'Pointer             {self.pointer[0]:.3f}, '
                    f'{self.pointer[1]:.3f}', 20, '#334a58')
                text(198, 358, f'Buttons held        {self.buttons}', 20,
                     '#334a58')
                text(198, 434, self.last_input, 17, '#267456')
                text(198, 500,
                     'No operating system, VM, subprocess, or physical HID.',
                     16, '#647782')
                text(
                    198, 532,
                    'This computer is a bounded in-memory object rendered as SVG.',
                    16, '#647782')
            text(18, 706, '●', 17, '#63d49b')
            text(42, 706, self.last_input, 14, '#dbe8ef')
            text(1000, 706, 'PRIVATE BROWSER SESSION', 13, '#bfd2df')
            pointer_x = min(1260, max(5, round(self.pointer[0] * WIDTH)))
            pointer_y = min(690, max(5, round(self.pointer[1] * HEIGHT)))
            body.append(f'<path transform="translate({pointer_x} {pointer_y})" '
                        'd="M0 0 L0 24 L6 18 L11 30 L17 27 L11 16 L21 16 Z" '
                        'fill="#f5f8ff" stroke="#111a2b" stroke-width="2"/>')
            return ('<svg xmlns="http://www.w3.org/2000/svg" width="1280" '
                    'height="720" viewBox="0 0 1280 720" '
                    'font-family="ui-monospace, monospace">' + ''.join(body) +
                    '</svg>')


def _deny_external_effects(event, _args):
    """Fail closed if a forgotten backend path tries to leave the demo."""
    if event in {
            'subprocess.Popen', 'os.system', 'os.posix_spawn', 'os.exec',
            'os.fork', 'os.forkpty', 'socket.connect'
    }:
        raise RuntimeError(
            'Demo isolation blocked a process or outbound connection')


def create_demo_app(username=None, password=None):
    """Create a real TinyPilot app in a fresh, private temporary directory."""
    if 'main' in sys.modules or 'env' in sys.modules:
        raise RuntimeError(
            'Run the demo in a fresh Python process, never inside a device server'
        )
    project = pathlib.Path(__file__).resolve().parents[1]
    os.chdir(project)
    sys.path.insert(0, str(project / 'app'))
    temporary_home = tempfile.TemporaryDirectory(
        prefix='tinypilot-webmcp-demo-')
    # macOS temp roots may be symlinks; TinyPilot requires a canonical home.
    os.environ['TINYPILOT_HOME_DIR'] = str(
        pathlib.Path(temporary_home.name).resolve())
    os.environ['DEBUG'] = '1'
    os.environ['USE_RELOADER'] = '0'
    # This demo deliberately uses Socket.IO's native threading mode. Loading
    # eventlet only for threads.reschedule breaks kqueue with macOS Python 3.9.
    # Supply the matching scheduling boundary before application imports.
    scheduler = types.ModuleType('threads')
    scheduler.reschedule = time.sleep
    sys.modules['threads'] = scheduler
    main = importlib.import_module('main')
    flask = importlib.import_module('flask')
    hid = importlib.import_module('hid.keycodes')
    hid_write = importlib.import_module('hid.write')
    fake_keyboard = importlib.import_module('hid.keyboard')
    fake_mouse = importlib.import_module('hid.mouse')
    text_to_hid = importlib.import_module('text_to_hid')
    api = importlib.import_module('api')
    views = importlib.import_module('views')
    update_logs = importlib.import_module('update_logs')
    app = main.app
    app.config.update(WEBMCP_DEMO=True, DEBUG=True, MAX_CONTENT_LENGTH=65536)
    with app.app_context():
        api.db.settings.Settings().set_requires_https(False)
        base_video_settings = api.update.settings.load()
        if username:
            username = importlib.import_module(
                'request_parsers.field_parsers.username').parse_username(
                    username)
            password = importlib.import_module(
                'request_parsers.field_parsers.password').parse_password(
                    password)

    character_map = {}
    for character in string.printable:
        try:
            key = text_to_hid.convert(character, 'en-US')
            if key is not None:
                character_map[(key.keycode, key.modifier)] = character
        except text_to_hid.UnsupportedCharacterError:
            continue
    devices = DemoDeviceRegistry(
        lambda: DemoDevice(hid, character_map, base_video_settings))

    def ensure_demo_session():
        session_id = flask.session.get(DEMO_SESSION_KEY)
        if not isinstance(session_id, str) or len(session_id) != 32:
            session_id = secrets.token_hex(16)
            flask.session[DEMO_SESSION_KEY] = session_id
        return session_id

    def current_device():
        if not flask.has_request_context():
            raise RuntimeError('Demo device access requires a browser session')
        device = devices.get(ensure_demo_session())
        device.ensure_owner(api.session.get_username())
        return device

    @app.before_request
    def attach_private_demo_session():
        ensure_demo_session()

    app.extensions['webmcp_demo_devices'] = devices
    app.extensions['webmcp_demo_home'] = temporary_home
    logging.getLogger().setLevel(logging.INFO)

    # Install replacements before any account creation triggers service work.
    def send_key(path, key):
        current_device().send_key(path, key)

    def send_keys(path, keys):
        current_device().send_keys(path, keys)

    def release_keys(path):
        current_device().release_keys(path)

    def send_mouse(path, buttons, relative_x, relative_y, vertical, horizontal):
        current_device().mouse(path, buttons, relative_x, relative_y, vertical,
                               horizontal)

    fake_keyboard.send_keystroke = send_key
    fake_keyboard.send_keystrokes = send_keys
    fake_keyboard.release_keys = release_keys
    fake_mouse.send_mouse_event = send_mouse

    # Paste normally runs after the request context has ended. Capture the
    # caller's private device before starting TinyPilot's background thread.
    original_background_thread = api.execute.background_thread

    def session_background_thread(function, args=None):
        if function is send_keys:
            function = current_device().send_keys
        return original_background_thread(function, args)

    api.execute.background_thread = session_background_thread

    def deny_hid(*_args, **_kwargs):
        raise hid_write.WriteError(
            'Physical HID writes are disabled in the demo')

    hid_write.write_to_hid_interface = deny_hid
    api.env.KEYBOARD_PATH = str(
        pathlib.Path(temporary_home.name) / 'demo-keyboard')
    api.env.MOUSE_PATH = str(pathlib.Path(temporary_home.name) / 'demo-mouse')
    # Account creation normally restarts video services. Seed the one real login
    # account only after replacing that hardware effect with a no-op.
    api.video_service.restart = lambda: None
    if username:
        with app.app_context():
            api.auth.register(username, password, api.auth.Role.ADMIN)
    api.hostname.determine = lambda: current_device().hostname

    def change_hostname(value):
        device = current_device()
        device.hostname = value
        device.service_event(f'Simulated hostname change to {value}')

    api.hostname.change = change_hostname
    api.local_system.shutdown = lambda: current_device().service_event(
        'Simulated appliance shutdown; demo stays online')
    api.local_system.restart = lambda: current_device().service_event(
        'Simulated appliance restart; demo stays online')
    api.video_service.restart = lambda: current_device().service_event(
        'Simulated video service restart')
    api.network.determine_wifi_settings = lambda: api.network.WifiSettings(
        *current_device().wifi, None)

    def enable_wifi(settings):
        device = current_device()
        device.wifi = (settings.country_code, settings.ssid)
        device.service_event(
            'Simulated Wi-Fi settings saved; password discarded')

    def disable_wifi():
        device = current_device()
        device.wifi = (None, None)
        device.service_event('Simulated Wi-Fi settings removed')

    api.network.enable_wifi = enable_wifi
    api.network.disable_wifi = disable_wifi
    api.network.determine_network_status = lambda: [
        api.network.InterfaceStatus('eth0', True, '192.0.2.17',
                                    '02-00-00-00-00-17')
    ]
    api.version.local_version = lambda: current_device().version
    api.version.latest_version = lambda: api.version.UpdateInfo(
        '0.0.1-webmcp-demo', 'automatic', None)

    def start_update():
        device = current_device()
        device.updated_at = time.monotonic()
        device.service_event('Simulated update started; no files downloaded')

    def update_status():
        device = current_device()
        if device.updated_at is None:
            return api.update.status.Status.NOT_RUNNING, None
        if time.monotonic() - device.updated_at < 2:
            return api.update.status.Status.IN_PROGRESS, None
        device.version = '0.0.1-webmcp-demo'
        return api.update.status.Status.DONE, None

    api.update.launcher.start_async = start_update
    api.update.status.get = update_status
    api.debug_logs.collect = lambda: '\n'.join([
        DEMO_LABEL,
        'Only sample service events follow; no host diagnostics read.',
        *current_device().state()['serviceEvents'],
    ])
    update_logs.read = lambda: api.debug_logs.collect()

    # Keep TinyPilot's validation and response contracts while storing settings
    # in the current browser's tiny in-memory computer.
    settings_class = api.db.settings.Settings
    settings_class.requires_https = lambda _self: current_device(
    ).requires_https
    settings_class.set_requires_https = lambda _self, value: setattr(
        current_device(), 'requires_https', value)
    settings_class.get_streaming_mode = lambda _self: api.db.settings.StreamingMode(
        current_device().streaming_mode)
    settings_class.set_streaming_mode = lambda _self, value: setattr(
        current_device(), 'streaming_mode', value.value)
    api.update.settings.load = lambda: copy.deepcopy(current_device().
                                                     video_settings)

    def save_video_settings(settings):
        device = current_device()
        device.video_settings = copy.deepcopy(settings)
        device.service_event('Simulated video settings saved')

    api.update.settings.save = save_video_settings

    # Account-management tools operate on a private sample directory. Passwords
    # are validated and immediately discarded; the shared login account is never
    # mutated by a demo tool call.
    @api.required_auth(api.auth.Role.ADMIN)
    def demo_users_get():
        device = current_device()
        current_username = api.session.get_username()
        return api.json_response.success({
            'users': [{
                'username': account_name,
                'role': role,
            } for account_name, role in device.users.items()],
            'currentUsername':
                current_username if current_username in device.users else None,
        })

    @api.required_auth(api.auth.Role.ADMIN)
    def demo_user_post():
        try:
            account_name, _password, role = api.request_parsers.create_user.parse(
                flask.request)
        except api.request_parsers.errors.Error as error:
            return api.json_response.error(error), 400
        device = current_device()
        if account_name in device.users:
            return api.json_response.error(
                RuntimeError('That sample user already exists')), 409
        device.users[account_name] = role.name
        device.service_event(f'Simulated user {account_name} added')
        return api.json_response.success({'username': account_name})

    @api.required_auth(api.auth.Role.OPERATOR)
    def demo_current_user_password_put():
        try:
            api.request_parsers.password.parse_password(flask.request)
        except api.request_parsers.errors.Error as error:
            return api.json_response.error(error), 400
        current_device().service_event('Simulated current-user password change')
        return api.json_response.success()

    @api.required_auth(api.auth.Role.ADMIN)
    def demo_user_password_put():
        try:
            account_name, _password = \
                api.request_parsers.credentials.parse_credentials(flask.request)
        except api.request_parsers.errors.Error as error:
            return api.json_response.error(error), 400
        device = current_device()
        if account_name not in device.users:
            return api.json_response.error(
                RuntimeError('That sample user does not exist')), 404
        device.service_event(f'Simulated password change for {account_name}')
        return api.json_response.success()

    @api.required_auth(api.auth.Role.ADMIN)
    def demo_user_delete():
        try:
            account_name = api.request_parsers.delete_user.parse_delete(
                flask.request)
        except api.request_parsers.errors.Error as error:
            return api.json_response.error(error), 400
        device = current_device()
        if account_name not in device.users:
            return api.json_response.error(
                RuntimeError('That sample user does not exist')), 404
        del device.users[account_name]
        device.service_event(f'Simulated user {account_name} removed')
        return api.json_response.success({'username': account_name})

    @api.required_auth(api.auth.Role.ADMIN)
    def demo_users_delete():
        device = current_device()
        device.users.clear()
        device.service_event('All simulated users removed')
        return api.json_response.success()

    app.view_functions.update({
        'api.users_get': demo_users_get,
        'api.user_post': demo_user_post,
        'api.current_user_password_put': demo_current_user_password_put,
        'api.user_password_put': demo_user_password_put,
        'api.user_delete': demo_user_delete,
        'api.users_delete': demo_users_delete,
    })

    @views.require_authentication
    def stream():
        response = flask.Response(current_device().svg(),
                                  mimetype='image/svg+xml')
        response.headers['Cache-Control'] = 'no-store'
        response.headers['X-TinyPilot-Demo'] = 'true'
        return response

    app.view_functions['views.stream_get'] = stream
    app.add_url_rule('/snapshot', 'webmcp_demo_snapshot', stream)

    @app.get('/webmcp-demo/state')
    @views.require_authentication
    def demo_state():
        return flask.jsonify(current_device().state())

    @app.post('/webmcp-demo/reset')
    @views.require_authentication
    def demo_reset():
        current_device().reset()
        return flask.jsonify({
            'demo': True,
            'reset': True,
            'sessionIsolated': True,
        })

    @app.context_processor
    def demo_context():
        return {'WEBMCP_DEMO': True, 'is_webmcp_demo': True}

    @flask.before_render_template.connect_via(app)
    def demo_video_renderer(_sender, template, context, **_extra):
        # Explicit view context wins over context processors, so set this at
        # render time. H.264 settings remain stored; the demo has no encoder.
        if template.name == 'index.html':
            context['use_webrtc_remote_screen'] = False

    @app.after_request
    def label_demo(response):
        response.headers['X-TinyPilot-Demo'] = 'true'
        # Existing browser controls (for example log sharing) also stay local.
        response.headers[
            'Content-Security-Policy'] = "connect-src 'self'; object-src 'none'; base-uri 'self'"
        if response.mimetype == 'text/html' and not response.direct_passthrough:
            source = response.get_data(as_text=True)
            source = source.replace(
                '</head>',
                '<script>window.TINYPILOT_WEBMCP_DEMO = true;</script></head>')
            source = source.replace(
                '</body>',
                '<script type="module" src="/js/webmcp-demo.js"></script></body>'
            )
            response.set_data(source)
        return response

    socketio = main.socket_api.socketio
    socketio.init_app(app, async_mode='threading')
    sys.addaudithook(_deny_external_effects)
    return app, socketio, devices


def main():
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--host',
                        default='127.0.0.1',
                        help='Bind host (default: localhost only)')
    parser.add_argument('--port', type=int, default=8000)
    parser.add_argument('--username', help='Seed a demo administrator account')
    parser.add_argument(
        '--password-env',
        default='TINYPILOT_DEMO_PASSWORD',
        help='Environment variable containing the seeded account password')
    parser.add_argument(
        '--self-test',
        action='store_true',
        help=
        'Check real routes, CSRF, auth, simulated input, and isolation; do not listen'
    )
    args = parser.parse_args()
    if not 1 <= args.port <= 65535:
        parser.error('--port must be between 1 and 65535')
    if args.self_test:
        self_test()
        return
    password = os.environ.get(args.password_env)
    if args.username and not password:
        parser.error('A seeded account requires a password in --password-env')
    if args.host not in {'127.0.0.1', 'localhost', '::1'} and not args.username:
        parser.error(
            'External demo binds require --username and a password environment variable'
        )
    app, socketio, _devices = create_demo_app(args.username, password)
    print(
        f'\n{DEMO_LABEL}\nOpen http://{args.host}:{args.port}\n'
        'All device state is temporary; stop with Ctrl+C.\n',
        flush=True)
    if args.host in {'0.0.0.0', '::'}:
        # Werkzeug opens a UDP socket solely to choose a display address for its
        # startup log. Avoid that probe so the outbound-connection fence can
        # remain strict when the container binds to all interfaces.
        werkzeug_serving = importlib.import_module('werkzeug.serving')
        werkzeug_serving.get_interface_ip = lambda _family: '127.0.0.1'
    socketio.run(app,
                 host=args.host,
                 port=args.port,
                 debug=True,
                 use_reloader=False,
                 use_debugger=False,
                 allow_unsafe_werkzeug=True)


def self_test():
    """Exercise consequential behavior without starting a server or hardware."""
    demo_password = 'correct horse battery staple'
    app, socketio, devices = create_demo_app('judge', demo_password)

    def login(client):
        login_page = client.get('/login').get_data(as_text=True)
        login_token = re.search(r'name="csrf-token" content="([^"]+)"',
                                login_page).group(1)
        response = client.post('/api/auth',
                               json={
                                   'username': 'judge',
                                   'password': demo_password,
                               },
                               headers={'X-CSRFToken': login_token})
        assert response.status_code == 200
        page = client.get('/')
        token = re.search(r'name="csrf-token" content="([^"]+)"',
                          page.get_data(as_text=True)).group(1)
        with client.session_transaction() as browser_session:
            session_id = browser_session[DEMO_SESSION_KEY]
        return page, {'X-CSRFToken': token}, devices.get(session_id)

    client = app.test_client()
    page, headers, device = login(client)
    assert page.status_code == 200
    assert b'TINYPILOT_WEBMCP_DEMO = true' in page.data
    assert device.state()['sessionIsolated']
    assert device.state()['runtime'] == 'in-memory-svg'

    other_client = app.test_client()
    _other_page, other_headers, other_device = login(other_client)
    assert other_device is not device
    assert len(devices) == 2

    payload = {'text': '<script>demo</script>\n', 'language': 'en-US'}
    assert client.post('/api/paste', json=payload).status_code == 403
    assert device.text == ''
    assert client.post('/api/paste', json=payload,
                       headers=headers).status_code == 200
    deadline = time.monotonic() + 2
    while device.text != payload['text'] and time.monotonic() < deadline:
        time.sleep(0.01)
    assert device.text == payload['text']
    assert other_device.text == ''
    frame = client.get('/snapshot')
    assert frame.mimetype == 'image/svg+xml'
    assert b'&lt;script&gt;demo&lt;/script&gt;' in frame.data
    assert b'<script>demo</script>' not in frame.data
    assert b'TinyDesk' in frame.data
    assert b'PRIVATE BROWSER SESSION' in frame.data
    assert client.get('/stream').status_code == 200
    socket = socketio.test_client(app, flask_test_client=client)
    assert socket.is_connected()
    assert socket.emit('keystroke', {
        'code': 'KeyA',
        'ctrlLeft': True
    },
                       callback=True)['success']
    assert socket.emit('keystroke', {'code': 'Backspace'},
                       callback=True)['success']
    assert device.text == ''
    assert socket.emit('keystroke', {
        'code': 'KeyH',
        'shiftLeft': True
    },
                       callback=True)['success']
    assert socket.emit('keystroke', {'code': 'KeyI'}, callback=True)['success']
    assert device.text == 'Hi'
    assert socket.emit('keystroke', {
        'code': 'KeyS',
        'ctrlLeft': True
    },
                       callback=True)['success']
    assert device.saved
    pointer = {
        'buttons': 1,
        'relativeX': 0.1,
        'relativeY': 0.38,
        'verticalWheelDelta': 0,
        'horizontalWheelDelta': 0
    }
    assert socket.emit('mouse-event', pointer, callback=True)['success']
    assert device.active_tab == 'input'
    assert socket.emit('mouse-event', dict(pointer, relativeX=2),
                       callback=True) == {
                           'success': False
                       }
    assert client.put('/api/hostname',
                      json={
                          'hostname': 'invalid host'
                      },
                      headers=headers).status_code == 400
    assert client.put('/api/hostname',
                      json={
                          'hostname': 'demo-renamed'
                      },
                      headers=headers).status_code == 200
    assert device.hostname == 'demo-renamed'
    assert other_client.get('/api/hostname').json['hostname'] == 'tinydesk'
    wifi = {
        'countryCode': 'US',
        'ssid': 'Sample WiFi',
        'psk': 'demo-only-password'
    }
    assert client.put('/api/network/settings/wifi', json=wifi,
                      headers=headers).status_code == 200
    assert device.wifi == ('US', 'Sample WiFi')
    assert wifi['psk'] not in str(device.state())
    assert client.delete('/api/network/settings/wifi',
                         headers=headers).status_code == 200
    assert device.wifi == (None, None)
    assert other_client.get('/api/network/settings/wifi').json['ssid'] is None

    video_settings = client.get('/api/settings/video').json
    video_settings = {
        key: value
        for key, value in video_settings.items()
        if not key.startswith('default')
    }
    video_settings['mjpegQuality'] = 37
    assert client.put('/api/settings/video',
                      json=video_settings,
                      headers=headers).status_code == 200
    assert client.get('/api/settings/video').json['mjpegQuality'] == 37
    assert other_client.get('/api/settings/video').json['mjpegQuality'] != 37

    for endpoint in [
            '/api/restart', '/api/shutdown', '/api/settings/video/apply'
    ]:
        assert client.post(endpoint, headers=headers).status_code == 200
    assert client.put('/api/update', headers=headers).status_code == 200
    assert client.get('/api/update').json['status'] == 'IN_PROGRESS'
    device.updated_at -= 3
    assert client.get('/api/update').json['status'] == 'DONE'
    assert 'Simulated appliance restart' in client.get(
        '/api/debugLogs').get_data(as_text=True)
    account = {
        'username': 'demo-admin',
        'password': 'demo-only-password',
        'role': 'ADMIN'
    }
    assert client.post('/api/user', json=account,
                       headers=headers).status_code == 200
    assert any(user['username'] == 'demo-admin'
               for user in client.get('/api/users').json['users'])
    assert all(user['username'] != 'demo-admin'
               for user in other_client.get('/api/users').json['users'])

    password_change = {'password': 'a different valid password'}
    assert client.put('/api/currentUser/password',
                      json=password_change,
                      headers=headers).status_code == 200
    stranger = app.test_client()
    assert stranger.get('/api/users').status_code == 401
    assert stranger.get('/snapshot').status_code == 302
    assert not socketio.test_client(app,
                                    flask_test_client=stranger).is_connected()
    assert client.post('/api/logout', headers=headers).status_code == 200
    assert client.get('/api/users').status_code == 401
    _page, headers, same_device = login(client)
    assert same_device is device
    assert client.get('/api/users').status_code == 200

    assert other_client.post('/webmcp-demo/reset',
                             headers=other_headers).status_code == 200
    assert other_device.text == ''
    assert device.text == 'Hi'

    bounded = DemoDeviceRegistry(object, maximum=2)
    first = bounded.get('first')
    bounded.get('second')
    bounded.get('third')
    assert len(bounded) == 2
    assert bounded.get('first') is not first
    for event in ['subprocess.Popen', 'os.system', 'socket.connect']:
        try:
            sys.audit(event, None)
        except RuntimeError:
            pass
        else:
            raise AssertionError(f'Isolation failed for {event}')
    socket.disconnect()
    print('PASS: real routes, CSRF, auth, private browser sessions, bounded '
          'in-memory computers, SVG escaping, keyboard/mouse input, safe '
          'service simulations, and external-effect fence')


if __name__ == '__main__':
    main()
